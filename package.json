{
  "name": "douyin-vue",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "serve": "vite --host 127.0.0.1",
    "build": "vite build",
    "test-del-json": "node node/remove-dist-json.js",
    "build-uni-app": "vite build --mode uni",
    "build-gp-pages": "vite build --mode gp_pages",
    "build-gitee-pages": "vite build --mode gitee_pages && pnpm run test-del-json",
    "build-only": "vite build",
    "build-check": "run-p type-check \"build-only {@}\" --",
    "type-check": "vue-tsc --build --force",
    "type-check:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "pnpm test:client && pnpm test:server",
    "test:client": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:watch": "vitest",
    "test:e2e": "pnpm build --mode e2e && playwright test",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "tsx server/src/index.ts",
    "start:api:minimax": "CAIBAO_ENV_FILE=.env.minimax tsx server/src/index.ts",
    "start:api:doubao": "CAIBAO_ENV_FILE=.env.doubao tsx server/src/index.ts",
    "probe:douyin": "tsx server/src/cli/probe-douyin.ts",
    "prepare:authorized-media": "tsx server/src/cli/prepare-authorized-media.ts",
    "prepare:showcase-media": "tsx server/src/cli/prepare-showcase-media.ts",
    "generate:showcase-content": "tsx server/src/cli/generate-showcase-content.ts",
    "prepare:showcase": "pnpm prepare:showcase-media && pnpm generate:showcase-content",
    "stage:showcase-pages-media": "node scripts/stage-showcase-pages-media.mjs",
    "report": "vite build",
    "preview": "vite preview",
    "lint": "eslint  --fix  . --ext .vue,.js,.ts,.tsx,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "dependencies": {
    "@jambonn/vue-lazyload": "1.0.9",
    "axios": "^1.18.1",
    "axios-mock-adapter": "^1.22.0",
    "core-js": "3.21.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "libarchive-wasm": "^1.1.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.13",
    "vue-router": "4.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@iconify/vue": "^4.1.1",
    "@playwright/test": "^1.54.1",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node20": "^20.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.28",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.17.0",
    "git-last-commit": "^1.0.1",
    "husky": "^9.0.11",
    "jsdom": "^26.1.0",
    "less": "4.1.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.9.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "5.3.3",
    "unplugin-vue-macros": "^2.9.1",
    "vite": "^6.4.2",
    "vite-plugin-cdn-import": "0.3.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.0.6"
  },
  "lint-staged": {
    "*.{js,ts,vue,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,less,styl,html}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
