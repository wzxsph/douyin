# Vercel hosts the static Vite client only. Never upload provider credentials,
# imported media, generated analysis artifacts, or the unauthenticated API.
.env
.env.*
.analysis-work/
media-import/
public/demo/
server/
Dockerfile
docker-compose.analysis.yml
.dockerignore

# Source-only material that is not required by the production Vite build.
docs/
e2e/
node/
coverage/
test-results/
playwright-report/

# Historical/raw data copies are not read by the client at runtime.
public/data/videos.json
public/data/videos-old.json
public/data/user_video_list/

# The original simulator ships more than 100 MiB of local sample imagery. The
# deployed demo keeps only imagery referenced by the current client bundle;
# video payloads themselves continue to use their configured remote URLs.
public/images/*
!public/images/icon/
!public/images/icon/**
!public/images/goods/
!public/images/goods/**
